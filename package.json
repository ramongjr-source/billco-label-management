{
  "name": "billco-label-management",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "npm run db:setup && concurrently --kill-others --names api,ui \"npm:dev:api\" \"npm:dev:ui\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:ui": "vite",
    "db:setup": "tsx server/setup.ts",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && node scripts/copy-database-assets.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "start": "node dist-server/server/index.js",
    "preview": "npm run start",
    "test": "npm run test:server && npm run test:e2e",
    "test:server": "node --import tsx --test tests/server/*.test.ts",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.577.0",
    "multer": "^2.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/express": "^5.0.6",
    "@types/jsbarcode": "^3.11.4",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.4",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
